# Terraform (from github/gitignore Terraform.gitignore). The root lock file is
# committed so provider hash changes are reviewed; module lock files are not,
# because a module's providers are locked by the root that calls it.
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
modules/**/.terraform.lock.hcl

# Tool caches written by the Makefile's containers
.cache/

# Credentials and generated client configs
config.env
talosconfig
kubeconfig

# macOS
.DS_Store
