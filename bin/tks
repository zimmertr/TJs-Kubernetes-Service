#!/bin/bash
# Covers the cluster chores Terraform can't do itself: client configs, kubelet
# serving certificates, health checks, API tokens, taking a node out of the
# cluster when it's removed, restarting nodes one at a time so hardware changes
# (cores, memory, PCI devices) take effect, and registering nodes again after
# cluster.external_cloud_provider is turned on. Run it from the repo root, in
# the workspace of the cluster, after `source vars/config.env`.
set -euo pipefail

usage(){
  echo "Usage: $0 config               (merge the cluster into ~/.talos/config and ~/.kube/config)"
  echo "       $0 approve-csrs         (approve the nodes' pending kubelet serving certificates)"
  echo "       $0 doctor               (check the cluster's health)"
  echo "       $0 token USER           (print a user's API token from bootstrap/)"
  echo "       $0 remove NODE          (before or after deleting it from the tfvars)"
  echo "       $0 reboot [NODE...]     (every node, control planes first, if none are given)"
  echo "       $0 reregister [NODE...] (same order, once after turning on external_cloud_provider)"
  exit 1
}

# The root's `tks` output has one fact per line, so this reads it without a
# JSON parser. Node lines are: node NAME ROLE IP VMID PROXMOX_NODE POOL.
fact(){ awk -v k="$1" '$1 == k { print $2 }' <<< "$facts"; }
node_info(){ awk -v n="$1" '$1 == "node" && $2 == n { print $3, $4, $5, $6, $7 }' <<< "$facts"; }
node_ip(){ node_info "$1" | awk '{ print $2 }'; }
node_names(){ awk -v r="${1:-}" '$1 == "node" && (r == "" || $3 == r) { print $2 }' <<< "$facts"; }

# Proxmox's responses are flat enough to read a field without a JSON parser.
json_field(){ sed -n "s/.*\"$1\":\"\{0,1\}\([^\",}]*\).*/\1/p"; }

pve_api(){
  local insecure=""
  [ "${PROXMOX_VE_INSECURE:-}" = "true" ] && insecure=-k
  # shellcheck disable=SC2086 # $insecure is empty or a single flag
  curl -fsS $insecure -X "$1" -H "Authorization: PVEAPIToken=$PROXMOX_VE_API_TOKEN" \
    "$PROXMOX_VE_ENDPOINT/api2/json/$2"
}

# A Talos kubelet asks for its serving certificate through a CSR that nothing
# in a bare cluster approves, and kubectl logs and exec fail until it's
# approved. That happens when a node first boots and when the certificate
# rotates, not on a reboot, which keeps the certificate on disk. Only a pending
# CSR from the node itself that names nothing but the node's own hostname and
# IP is approved, which is what kubelet-csr-approver checks too.
approve_csrs(){
  local node=$1 ip=$2 csr sans
  for csr in $(kubectl get csr -o jsonpath='{range .items[?(@.spec.signerName=="kubernetes.io/kubelet-serving")]}{.metadata.name} {.spec.username} {.status.conditions}{"\n"}{end}' |
    awk -v u="system:node:$node" '$2 == u && NF == 2 { print $1 }'); do
    sans=$(kubectl get csr "$csr" -o jsonpath='{.spec.request}' | base64 -d |
      openssl req -noout -text | grep -A1 'Subject Alternative Name' | tail -n 1 | tr -d ' ' | tr ',' '\n' | sort | paste -sd , -)
    if [ "$sans" = "DNS:$node,IPAddress:$ip" ]; then
      kubectl certificate approve "$csr"
    else
      echo "Not approving $csr from $node: it asks for $sans"
    fi
  done
}

# Merges into the default locations rather than the files TALOSCONFIG and
# KUBECONFIG point at, which are this script's temporary copies. Entries a
# previous build of the same cluster left there are replaced, because their
# certificates no longer work.
config(){
  local talos_config=$HOME/.talos/config kube_config=$HOME/.kube/config context others cluster user
  mkdir -p "$HOME/.talos" "$HOME/.kube"

  context=$(awk '$1 == "context:" { print $2 }' "$TALOSCONFIG")
  others=$([ ! -f "$talos_config" ] || talosctl --talosconfig "$talos_config" config contexts |
    awk -v c="$context" 'NR > 1 { n = ($1 == "*" ? $2 : $1); if (n != c) print n }')
  if [ -z "$others" ]; then
    cp "$TALOSCONFIG" "$talos_config"
    chmod 600 "$talos_config"
  else
    # talosctl merge renames a context whose name is taken, and won't remove the
    # current context, so the old one is switched away from and removed first.
    talosctl --talosconfig "$talos_config" config context "$(head -n 1 <<< "$others")"
    talosctl --talosconfig "$talos_config" config remove "$context" --noconfirm > /dev/null 2>&1 || true
    talosctl --talosconfig "$talos_config" config merge "$TALOSCONFIG"
  fi
  talosctl --talosconfig "$talos_config" config context "$context"
  echo "Talos context $context is in $talos_config"

  read -r context cluster user <<< "$(kubectl config view -o jsonpath='{.contexts[0].name} {.contexts[0].context.cluster} {.contexts[0].context.user}')"
  if [ -f "$kube_config" ]; then
    kubectl --kubeconfig "$kube_config" config delete-context "$context" > /dev/null 2>&1 || true
    kubectl --kubeconfig "$kube_config" config delete-cluster "$cluster" > /dev/null 2>&1 || true
    kubectl --kubeconfig "$kube_config" config delete-user "$user" > /dev/null 2>&1 || true
    KUBECONFIG=$kube_config:$KUBECONFIG kubectl config view --flatten > "$tmp_dir/merged"
  else
    cp "$KUBECONFIG" "$tmp_dir/merged"
  fi
  chmod 600 "$tmp_dir/merged"
  mv "$tmp_dir/merged" "$kube_config"
  kubectl --kubeconfig "$kube_config" config use-context "$context" > /dev/null
  echo "Kubernetes context $context is in $kube_config"
}

doctor(){
  local failed=0 node role ip vm_id pve pool cp_ip controlplanes workers talos_version kubernetes_version
  check(){
    if "${@:2}" > /dev/null 2>&1; then echo "ok    $1"; else echo "FAIL  $1"; failed=1; fi
  }
  equal(){ [ "$1" = "$2" ]; }

  talos_version=$(fact talos_version)
  kubernetes_version=$(fact kubernetes_version)
  controlplanes=$(for node in $(node_names controlplane); do node_ip "$node"; done | paste -sd , -)
  workers=$(for node in $(node_names worker); do node_ip "$node"; done | paste -sd , -)
  cp_ip=${controlplanes%%,*}

  check "Proxmox API at $PROXMOX_VE_ENDPOINT" pve_api GET version
  for node in $(node_names); do
    read -r role ip vm_id pve pool <<< "$(node_info "$node")"
    check "$node: VM $vm_id is running" equal running "$(pve_api GET "nodes/$pve/qemu/$vm_id/status/current" 2> /dev/null | json_field status)"
    check "$node: Talos $talos_version" equal "$talos_version" "$(talosctl -n "$ip" version 2> /dev/null | awk '$1 == "Tag:" { tag = $2 } END { print tag }')"
    check "$node: Kubernetes $kubernetes_version" equal "$kubernetes_version" "$(kubectl get node "$node" -o jsonpath='{.status.nodeInfo.kubeletVersion}' 2> /dev/null)"
    check "$node: Ready" kubectl wait --for=condition=Ready "node/$node" --timeout=1s
    if [ "$pool" = "gpu" ]; then
      check "$node: GPU driver loaded (/dev/dri/renderD*)" grep -q renderD <<< "$(talosctl -n "$ip" ls /dev/dri 2> /dev/null)"
    fi
  done
  check "etcd members are the control planes" equal "$(node_names controlplane | sort | paste -sd , -)" \
    "$(talosctl -n "$cp_ip" etcd members 2> /dev/null | awk 'NR > 1 { print $3 }' | sort | paste -sd , -)"
  # shellcheck disable=SC2046 # either nothing or a flag and its value
  check "talosctl health" talosctl -n "$cp_ip" health --wait-timeout 2m --control-plane-nodes "$controlplanes" \
    $([ -z "$workers" ] || echo --worker-nodes "$workers")
  return "$failed"
}

# bootstrap/ has its own state, so the cluster's workspace doesn't apply to it.
token(){
  local tokens
  tokens=$(env -u TF_WORKSPACE terraform -chdir=bootstrap output -raw tks)
  awk -v u="$1" '$1 == u { print $2; found = 1 } END { exit !found }' <<< "$tokens" ||
    { echo "bootstrap/ has no token for $1. It has: $(awk '{ print $1 }' <<< "$tokens" | paste -sd ' ' -)" >&2; exit 1; }
}

# Terraform only deletes a removed node's VM, so a full destroy never waits on
# the cluster. This does the rest, whichever side of the apply it runs on.
remove_node(){
  local node=$1 ip cp_ip="" candidate member_id
  ip=$(node_ip "$node")
  [ -n "$ip" ] || ip=$(kubectl get node "$node" -o jsonpath='{.status.addresses[?(@.type=="InternalIP")].address}' 2> /dev/null || true)

  # etcd is read and changed through another control plane, so the last one
  # can never be removed.
  for candidate in $(node_names controlplane); do
    [ "$candidate" != "$node" ] || continue
    candidate=$(node_ip "$candidate")
    if talosctl -n "$candidate" version > /dev/null 2>&1; then cp_ip=$candidate; break; fi
  done
  [ -n "$cp_ip" ] || { echo "$node is the last reachable control plane, so it can't be removed safely"; exit 1; }
  member_id=$(talosctl -n "$cp_ip" etcd members | awk -v n="$node" '$3 == n { print $2 }')

  if [ -n "$ip" ] && talosctl -n "$ip" version > /dev/null 2>&1; then
    echo "==> $node is running: draining it and resetting it"
    kubectl drain "$node" --ignore-daemonsets --delete-emptydir-data --timeout=10m
    # A graceful reset leaves etcd before it wipes the node.
    talosctl -n "$ip" reset --graceful=true --reboot=false --wait=false
    if [ -n "$member_id" ]; then
      # grep reads all its input: -q would let pipefail end the wait early.
      while talosctl -n "$cp_ip" etcd members | awk '{ print $3 }' | grep -x "$node" > /dev/null; do sleep 5; done
    fi
  elif [ -n "$member_id" ]; then
    echo "==> $node is gone: removing its etcd member"
    talosctl -n "$cp_ip" etcd remove-member "$member_id"
  fi
  kubectl delete node "$node" --ignore-not-found
}

# A reboot from inside Talos keeps the same QEMU process, so pending hardware
# changes only apply when Proxmox restarts the VM.
reboot_node(){
  local node=$1 role ip vm_id pve pool upid
  read -r role ip vm_id pve pool <<< "$(node_info "$node")"
  [ -n "$vm_id" ] || { echo "$node is not in this cluster"; exit 1; }

  echo "==> $node"
  kubectl drain "$node" --ignore-daemonsets --delete-emptydir-data --timeout=10m
  upid=$(pve_api POST "nodes/$pve/qemu/$vm_id/status/reboot" | json_field data)
  until [ "$(pve_api GET "nodes/$pve/tasks/$upid/status" | json_field status)" = "stopped" ]; do sleep 5; done
  # The API is unreachable while the only control plane restarts.
  until kubectl wait --for=condition=Ready "node/$node" --timeout=10m 2> /dev/null; do sleep 5; done
  if [ "$role" = "controlplane" ]; then
    # Rebooting the next control plane before etcd is back would cost quorum.
    until talosctl -n "$ip" etcd status > /dev/null 2>&1; do sleep 5; done
  fi
  kubectl uncordon "$node"
}

# A cloud controller manager only initializes a node as it registers, so nodes
# that joined before external_cloud_provider was on have to register again.
reregister_node(){
  local node=$1 role ip vm_id pve pool deadline
  read -r role ip vm_id pve pool <<< "$(node_info "$node")"
  [ -n "$ip" ] || { echo "$node is not in this cluster"; exit 1; }

  echo "==> $node"
  kubectl drain "$node" --ignore-daemonsets --delete-emptydir-data --timeout=10m
  kubectl delete node "$node"
  # The reboot would leave its DaemonSet pods Failed or Succeeded and still
  # bound to the node's name. If it registers again before PodGC removes them,
  # the DaemonSet controller counts those pods as already on the new Node and
  # may not sync until something unrelated changes. Only DaemonSet and static
  # pods remain after the drain, and the reboot is about to stop them anyway.
  kubectl delete pods --all-namespaces --field-selector "spec.nodeName=$node" --grace-period=0 --force
  # The new Node gets a new pod CIDR, and Flannel and the CNI bridge only take
  # it up on a fresh boot. A kubelet restart leaves pods on the old CIDR with
  # no routes to them from the other nodes.
  talosctl -n "$ip" reboot
  # The new Node isn't cordoned, so it's done once the CCM has given it a
  # providerID and it's Ready.
  deadline=$((SECONDS + 600))
  until [ -n "$(kubectl get node "$node" -o jsonpath='{.spec.providerID}' 2> /dev/null)" ]; do
    [ "$SECONDS" -lt "$deadline" ] || { echo "$node has no providerID after 10 minutes. Is the cloud controller manager running?"; exit 1; }
    sleep 5
  done
  until kubectl wait --for=condition=Ready "node/$node" --timeout=10m 2> /dev/null; do sleep 5; done
  if [ "$role" = "controlplane" ]; then
    until talosctl -n "$ip" etcd status > /dev/null 2>&1; do sleep 5; done
  fi
}

main(){
  [ $# -ge 1 ] || usage
  if [ "$1" = "token" ]; then
    [ $# -eq 2 ] || usage
    token "$2"
    return
  fi

  tmp_dir=$(mktemp -d)
  trap 'rm -rf "$tmp_dir"' EXIT
  # Without its backend, Terraform quietly falls back to an empty local state,
  # so a missing cloud_override.tf shows up here rather than as a new cluster.
  facts=$(terraform output -raw tks 2> /dev/null || true)
  [ -n "$facts" ] ||
    { echo "Workspace $(terraform workspace show) has no TKS cluster. Is its backend configured, and has it been applied?" >&2; exit 1; }
  terraform output -raw kubeconfig > "$tmp_dir/kubeconfig"
  terraform output -raw talosconfig > "$tmp_dir/talosconfig"
  export KUBECONFIG=$tmp_dir/kubeconfig
  export TALOSCONFIG=$tmp_dir/talosconfig

  case "$1" in
    config)
      [ $# -eq 1 ] || usage
      config
      ;;
    doctor)
      [ $# -eq 1 ] || usage
      doctor
      ;;
    approve-csrs)
      [ $# -eq 1 ] || usage
      for node in $(node_names); do approve_csrs "$node" "$(node_ip "$node")"; done
      ;;
    remove)
      [ $# -eq 2 ] || usage
      remove_node "$2"
      ;;
    reboot | reregister)
      command=$1
      shift
      # shellcheck disable=SC2046 # hostnames have no spaces
      [ $# -gt 0 ] || set -- $(node_names)
      for node in "$@"; do "${command}_node" "$node"; done
      ;;
    *)
      usage
      ;;
  esac
}

main "$@"
